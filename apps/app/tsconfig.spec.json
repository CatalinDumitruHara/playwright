{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "../../dist/out-tsc",
    "module": "commonjs",
    "target": "es2016",
    "experimentalDecorators": true,
    "types": ["jest", "node"],
    "baseUrl": ".",
    "paths": {
      "@mapfre-tech/b2b-components/*": [
        "src/__mocks__/@mapfre-tech/b2b-components/*.ts"
      ]
    },
    "strictPropertyInitialization": false
  },
  "files": ["src/test-setup.ts"],
  "include": [
    "jest.config.ts",
    "src/**/*.test.ts",
    "src/**/*.spec.ts",
    "src/**/*.d.ts"
  ]
}
